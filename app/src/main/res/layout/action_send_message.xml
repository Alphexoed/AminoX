<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_gravity="center"
    android:id="@id/ActionSendMessageLayout"
    android:background="#ff130e41"
    android:padding="6.0dip"
    android:layout_width="320.0dip"
    android:layout_height="400.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Spinner
        android:id="@id/spinnerChats"
        android:background="@drawable/windowstyle2"
        android:padding="5.0dip"
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:spinnerMode="dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />
    <Button
        android:textColor="#ff130e41"
        android:id="@id/buttonASendMessageSend"
        android:background="@drawable/buttongradient"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="128.0dip"
        android:layout_height="48.0dip"
        android:layout_marginTop="24.0dip"
        android:layout_marginBottom="4.0dip"
        android:text="@string/send"
        app:layout_constraintBottom_toTopOf="@id/buttonASendMessageClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputSMMessage"
        app:layout_constraintVertical_bias="0.95" />
    <EditText
        android:textColor="@color/white"
        android:textColorHint="#ffd0d0e8"
        android:gravity="center|left|top"
        android:id="@id/inputSMMessage"
        android:background="@drawable/inputbox"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="145.0dip"
        android:layout_marginTop="8.0dip"
        android:hint="@string/sm_message"
        android:cursorVisible="true"
        android:inputType="textLongMessage|textMultiLine"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinnerChats"
        app:layout_constraintVertical_bias="0.0" />
    <EditText
        android:textColor="@color/white"
        android:textColorHint="#ffd0d0e8"
        android:gravity="center|left"
        android:id="@id/inputSMType"
        android:background="@drawable/inputbox"
        android:padding="10.0dip"
        android:layout_width="64.0dip"
        android:layout_height="48.0dip"
        android:layout_marginTop="8.0dip"
        android:hint="@string/sm_type"
        android:cursorVisible="true"
        android:inputType="number"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputSMMessage"
        app:layout_constraintVertical_bias="0.0" />
    <Button
        android:textColor="#ff11f7d1"
        android:id="@id/buttonASendMessageClose"
        android:background="@drawable/buttongradient2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="128.0dip"
        android:layout_height="48.0dip"
        android:layout_marginTop="24.0dip"
        android:text="@string/close"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />
</androidx.constraintlayout.widget.ConstraintLayout>