<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/ActionSelectorLayout"
    android:padding="6.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textColor="#ffd0d0e8"
        android:autoLink="web"
        android:linksClickable="true"
        android:id="@id/infoTxtCredits2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Made by Slimakoi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />
    <TextView
        android:textSize="18.0sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@id/idcomidselector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16.0dip"
        android:text="@string/titlecomidselector"
        app:layout_constraintBottom_toTopOf="@id/communityScroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <ScrollView
        android:layout_gravity="center"
        android:id="@id/communityScroll"
        android:background="@drawable/windowstyle2"
        android:padding="10.0dip"
        android:layout_width="305.0dip"
        android:layout_height="425.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.556">
        <RadioGroup
            android:theme="@style/AppTheme"
            android:id="@id/radioGroup"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
    <Button
        android:textColor="#ff130e41"
        android:id="@id/buttonCommunity"
        android:background="@drawable/buttongradient"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="134.0dip"
        android:layout_height="48.0dip"
        android:text="@string/ok"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.95" />
    <TextView
        android:textSize="20.0sp"
        android:textColor="@color/accent"
        android:gravity="center|left"
        android:id="@id/profileName"
        android:layout_width="wrap_content"
        android:layout_height="48.0dip"
        android:layout_marginStart="18.0dip"
        app:layout_constraintBottom_toTopOf="@id/profileCreation"
        app:layout_constraintStart_toEndOf="@id/profileImage"
        app:layout_constraintTop_toTopOf="@id/profileImage" />
    <TextView
        android:textSize="15.0sp"
        android:textColor="#ffb3aeca"
        android:gravity="center|left"
        android:id="@id/profileCreation"
        android:layout_width="wrap_content"
        android:layout_height="24.0dip"
        android:layout_marginStart="18.0dip"
        app:layout_constraintBottom_toBottomOf="@id/profileImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/profileImage"
        app:layout_constraintTop_toBottomOf="@id/profileName"
        app:layout_constraintVertical_bias="0.0" />
    <WebView
        android:id="@id/profileImage"
        android:layout_width="80.0dip"
        android:layout_height="80.0dip"
        android:layout_marginTop="10.0dip"
        android:scaleType="centerCrop"
        android:layout_marginStart="10.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />
    <Button
        android:textColor="#ff11f7d1"
        android:id="@id/buttonCopySid"
        android:background="@drawable/buttongradient2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="86.0dip"
        android:layout_height="32.0dip"
        android:text="@string/copy_sid"
        android:contentDescription="@string/copy_sid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />
</androidx.constraintlayout.widget.ConstraintLayout>