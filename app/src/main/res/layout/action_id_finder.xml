<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_gravity="center"
    android:id="@id/ActionIdFinderLayout"
    android:background="#ff130e41"
    android:padding="6.0dip"
    android:layout_width="320.0dip"
    android:layout_height="300.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Button
        android:textColor="#ff130e41"
        android:id="@id/buttonIdFinderSearch"
        android:background="@drawable/buttongradient"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="128.0dip"
        android:layout_height="48.0dip"
        android:layout_marginTop="24.0dip"
        android:text="@string/search"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@id/buttonIdFinderClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/urlIdFinder"
        app:layout_constraintVertical_bias="0.95" />
    <Button
        android:textColor="#ff11f7d1"
        android:id="@id/buttonIdFinderClose"
        android:background="@drawable/buttongradient2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="128.0dip"
        android:layout_height="48.0dip"
        android:layout_marginTop="24.0dip"
        android:text="@string/close"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />
    <EditText
        android:textColor="@color/white"
        android:textColorHint="#ffd0d0e8"
        android:id="@id/urlIdFinder"
        android:background="@drawable/inputbox"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:hint="@string/target_url"
        android:ems="10"
        android:inputType="textLongMessage"
        android:autofillHints=""
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/linearLayoutNickname"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="100.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/urlIdFinder">
        <LinearLayout
            android:layout_width="200.0dip"
            android:layout_height="wrap_content"
            android:weightSum="100.0"
            android:layout_weight="50.0">
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:gravity="center|left"
                android:id="@id/layoutNickname"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="10.0dip"
                android:text="@string/nickname"
                android:layout_weight="50.0" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="100.0"
            android:layout_weight="50.0">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/infoIdNickname"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:text="@string/unknown"
                android:layout_weight="50.0"
                android:textAlignment="textStart" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/linearLayoutCommunity"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="100.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutNickname">
        <LinearLayout
            android:layout_width="200.0dip"
            android:layout_height="wrap_content"
            android:weightSum="100.0"
            android:layout_weight="50.0">
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:gravity="center|left"
                android:id="@id/layoutCommunity"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="10.0dip"
                android:text="@string/community"
                android:layout_weight="50.0" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="100.0"
            android:layout_weight="50.0">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/infoIdCommunity"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:text="@string/unknown"
                android:layout_weight="50.0"
                android:textAlignment="textStart" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/linearObjectId"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="100.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutCommunity">
        <LinearLayout
            android:layout_width="200.0dip"
            android:layout_height="wrap_content"
            android:weightSum="100.0"
            android:layout_weight="50.0">
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:gravity="center|left"
                android:id="@id/layoutObjectId"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="10.0dip"
                android:text="@string/object_id"
                android:layout_weight="50.0" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="100.0"
            android:layout_weight="50.0">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/infoIdObjectId"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:text="@string/unknown"
                android:layout_weight="50.0"
                android:textAlignment="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>